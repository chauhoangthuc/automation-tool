{
  "name": "ielts-space-reading",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --configLoader runner --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "start": "tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "seed:type-drafts": "node --experimental-strip-types scripts/create-type-drafts.ts",
    "seed:type-previews": "npm run seed:type-drafts && node scripts/populate-type-previews.mjs",
    "seed:falkirk-diagram": "node scripts/create-falkirk-diagram-draft.mjs",
    "test": "tsx tests/smoke.ts",
    "test:validation": "tsx tests/validation.ts",
    "test:grading": "tsx tests/grading.ts",
    "setup:python": "node scripts/setup-python.mjs",
    "test:pdf-import": ".venv\\Scripts\\python.exe tests\\pdf_import_test.py"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "sanitize-html": "^2.18.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "playwright": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
